    </div>
    <div class="chips">
      <span class="chip"><svg viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>ส่งไอดีอัตโนมัติ</span>
      <span class="chip"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>ชำระเงินปลอดภัย</span>
      <span class="chip"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M5.6 5.6l3.9 3.9M14.5 14.5l3.9 3.9M18.4 5.6l-3.9 3.9M9.5 14.5l-3.9 3.9"/></svg>ประกันหลังการขาย</span>
    </div>
  </section>


  <div class="sec-head" id="shop">
    <h2>สินค้า</h2>
    <div class="tabs" role="group" aria-label="หมวดสินค้า" id="tabs"></div>
  </div>
  <div class="grid" id="grid"></div>

  <div class="sec-head" id="how"><h2>ซื้อง่าย 3 ขั้นตอน</h2></div>
  <div class="steps">
    <div class="step"><h3>เลือกไอดี</h3><p>เลือกแพ็กที่ต้องการ ราคาแสดงชัดเจน ไม่มีค่าใช้จ่ายแฝง</p></div>
    <div class="step"><h3>ชำระเงิน</h3><p>เติมเงินเข้าระบบหรือโอนตามยอด ระบบตรวจยอดให้เอง</p></div>
    <div class="step"><h3>รับ user/password</h3><p>ข้อมูลไอดีขึ้นที่หน้าเว็บทันที ดูย้อนหลังได้ในหน้าออเดอร์</p></div>
  </div>

  <footer id="contact">
    <a class="brand" href="#top"><img alt="" src="data:image/webp;base64,"><span>BB <b>ช้อป</b></span></a>
    <div class="contacts" id="contacts-foot"></div>
    <p class="fine">© BB ช้อป · เปิดขายตลอด 24 ชม.</p>
  </footer>
</main>

<div class="scrim" id="scrim"></div>

<aside class="drawer" id="drawer" aria-hidden="true" aria-label="เมนู">
  <div class="top">
    <a class="brand" href="#top"><img alt="" src="data:image/webp;base64,"><span>BB <b>ช้อป</b></span></a>
    <button class="icon-btn" id="close-menu" type="button" aria-label="ปิดเมนู"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  </div>
  <nav class="menu">
    <a href="#shop" data-close><svg viewBox="0 0 24 24"><path d="M4 9l1.5-5h13L20 9M4 9v11h16V9M4 9h16M9 20v-6h6v6"/></svg>ร้านค้า</a>
    <a href="#shop" data-close data-tab="all"><svg viewBox="0 0 24 24"><path d="M4 7h16M7 12h10M10 17h4"/></svg>เลือกไอดีเอง</a>
    <a href="#top" data-close data-topup><svg viewBox="0 0 24 24"><path d="M4 7a2 2 0 012-2h11v4M4 7v11a2 2 0 002 2h14V9H6a2 2 0 01-2-2z"/><path d="M16.5 14.5h.01"/></svg>เติมเงิน</a>
  </nav>
  <h4 id="contact-h">ติดต่อเรา</h4>
  <div class="contacts" id="contacts-menu"></div>
  <button class="btn ghost" type="button" data-auth="login">เข้าสู่ระบบ</button>
  <button class="btn primary" type="button" data-auth="signup">สมัครสมาชิก</button>
</aside>

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="m-title"></div>
<div class="toast" id="toast" role="status"></div>

<div class="cookie" id="cookie"><div>
  <p>เว็บนี้ใช้คุกกี้เพื่อระบบและวัดผลโฆษณา · <a href="#contact">รายละเอียด</a></p>
  <button class="btn primary" type="button" id="cookie-ok">ตกลง</button>
</div></div>

<script>
/* ===== ตั้งค่าร้าน: แก้ตรงนี้ ===== */
var CONTACTS=[];
var PRODUCTS=[];
var CATS=[['all','ทั้งหมด']];
/* ================================== */

var $=function(s,r){return (r||document).querySelector(s)};
var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
var baht=function(n){return '฿'+n.toLocaleString('th-TH')};
var tabNow='all';

function toast(msg){var t=$('#toast');t.textContent=msg;t.classList.add('on');clearTimeout(toast.h);toast.h=setTimeout(function(){t.classList.remove('on')},2600)}


/* products */
function renderTabs(){
  $('#tabs').hidden=CATS.length<2;
  $('#tabs').innerHTML=CATS.map(function(c){return '<button type="button" class="tab" data-cat="'+c[0]+'" aria-pressed="'+(c[0]===tabNow)+'">'+c[1]+'</button>'}).join('');
}
function renderGrid(){
  var list=PRODUCTS.filter(function(p){return tabNow==='all'||p.cat===tabNow});
  $('#grid').innerHTML=list.map(function(p,i){
    return '<article class="card"><div class="art"><span class="q q1">?</span><span class="q q2">?</span>'+
      '<span class="ready"><i></i>พร้อมส่งทันที</span><div class="name">'+p.art+'</div><div class="price">'+p.price+' THB</div></div>'+
      '<div class="body"><small>'+p.sub+'</small><h3>'+p.title+'</h3>'+
      '<div class="buy-row"><div><span>ราคา</span><b>'+baht(p.price)+'</b></div><button type="button" class="buy'+(i===1?' hot':'')+'" data-buy="'+p.id+'">ซื้อ →</button></div></div></article>';
  }).join('')||'<div class="empty"><b>กำลังเตรียมสินค้า</b><span>เร็ว ๆ นี้ ติดตามได้ที่หน้านี้</span></div>';
}
function setTab(c){tabNow=c;renderTabs();renderGrid()}
$('#tabs').addEventListener('click',function(e){var b=e.target.closest('[data-cat]');if(b)setTab(b.dataset.cat)});
renderTabs();renderGrid();

/* contacts */
function contactsHtml(){return CONTACTS.map(function(c){return '<button type="button" class="contact" data-copy="'+c.val+'"><b>'+c.name+'</b><span>'+c.val+'</span></button>'}).join('')}
$('#contacts-foot').innerHTML=contactsHtml();$('#contacts-menu').innerHTML=contactsHtml();
if(!CONTACTS.length){$('#contacts-foot').hidden=true;$('#contacts-menu').hidden=true;$('#contact-h').hidden=true;$$('a[href="#contact"]').forEach(function(a){if(a.closest('.nav'))a.hidden=true})}
document.addEventListener('click',function(e){
  var c=e.target.closest('[data-copy]');if(!c)return;
  var v=c.dataset.copy;
  (navigator.clipboard&&navigator.clipboard.writeText?navigator.clipboard.writeText(v):Promise.reject()).then(function(){toast('คัดลอกแล้ว')},function(){toast(v)});
});

/* drawer */
function drawer(on){$('#drawer').classList.toggle('on',on);$('#scrim').classList.toggle('on',on||$('#modal').classList.contains('on'));$('#drawer').setAttribute('aria-hidden',String(!on))}
$('#open-menu').addEventListener('click',function(){drawer(true)});
$('#close-menu').addEventListener('click',function(){drawer(false)});
$$('[data-close]').forEach(function(a){a.addEventListener('click',function(){drawer(false);if(a.dataset.tab)setTab(a.dataset.tab)})});

/* modal */
function modal(html){var m=$('#modal');m.innerHTML=html;m.classList.add('on');$('#scrim').classList.add('on')}
function closeModal(){$('#modal').classList.remove('on');if(!$('#drawer').classList.contains('on'))$('#scrim').classList.remove('on')}
$('#scrim').addEventListener('click',function(){closeModal();drawer(false)});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeModal();drawer(false)}});
$('#modal').addEventListener('click',function(e){if(e.target.closest('[data-x]'))closeModal()});

$('#grid').addEventListener('click',function(e){
  var b=e.target.closest('[data-buy]');if(!b)return;
  var p=PRODUCTS.filter(function(x){return x.id==b.dataset.buy})[0];
  modal('<h3 id="m-title">ยืนยันคำสั่งซื้อ</h3><p>'+p.title+'</p>'+
    '<div class="sum"><span>ยอดชำระ</span><b>'+baht(p.price)+'</b></div>'+
    '<label for="m-contact">ช่องทางรับแจ้งเตือน (LINE หรืออีเมล)</label><input id="m-contact" autocomplete="off" placeholder="เช่น @line หรือ name@mail.com">'+
    '<p class="note">เว็บนี้เป็นหน้าตัวอย่าง ยังไม่ได้เชื่อมระบบชำระเงินและระบบส่งไอดีจริง</p>'+
    '<div class="row"><button class="btn ghost" type="button" data-x>ยกเลิก</button><button class="btn primary" type="button" id="m-pay">ไปชำระเงิน</button></div>');
  $('#m-pay').addEventListener('click',function(){closeModal();toast('ตัวอย่าง: ต่อระบบชำระเงินที่ปุ่มนี้')});
});

$('#check-order').addEventListener('click',function(){
  modal('<h3 id="m-title">เช็คออเดอร์ของฉัน</h3><p>กรอกเลขออเดอร์เพื่อดูสถานะและข้อมูลไอดี</p>'+
    '<label for="m-order">เลขออเดอร์</label><input id="m-order" autocomplete="off" placeholder="เช่น BB-000123">'+
    '<div class="result" id="m-res"></div>'+
    '<div class="row"><button class="btn ghost" type="button" data-x>ปิด</button><button class="btn primary" type="button" id="m-find">ค้นหา</button></div>');
  $('#m-find').addEventListener('click',function(){
    var v=$('#m-order').value.trim();
    $('#m-res').textContent=v?'ยังไม่ได้เชื่อมฐานข้อมูลออเดอร์ ระบบจริงจะแสดงสถานะของ '+v+' ตรงนี้':'กรอกเลขออเดอร์ก่อนค้นหา';
  });
});
$$('[data-auth]').forEach(function(b){b.addEventListener('click',function(){
  var login=b.dataset.auth==='login';drawer(false);
  modal('<h3 id="m-title">'+(login?'เข้าสู่ระบบ':'สมัครสมาชิก')+'</h3><p>'+(login?'ใช้ดูออเดอร์และเติมเงิน':'สมัครฟรี ใช้เวลาไม่ถึงนาที')+'</p>'+
    '<label for="a-user">ชื่อผู้ใช้</label><input id="a-user" autocomplete="username">'+
    '<label for="a-pass">รหัสผ่าน</label><input id="a-pass" type="password" autocomplete="'+(login?'current-password':'new-password')+'">'+
    '<p class="note">หน้าตัวอย่าง ยังไม่ได้เชื่อมระบบสมาชิกจริง</p>'+
    '<div class="row"><button class="btn ghost" type="button" data-x>ปิด</button><button class="btn primary" type="button" data-x>'+(login?'เข้าสู่ระบบ':'สมัคร')+'</button></div>');
})});
$('[data-topup]').addEventListener('click',function(){toast('เมนูเติมเงิน: ต่อระบบชำระเงินที่นี่')});

/* theme + cookie */
$('#theme').addEventListener('click',function(){
  var r=document.documentElement,cur=r.getAttribute('data-theme');
  if(!cur)cur=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';
  r.setAttribute('data-theme',cur==='dark'?'light':'dark');
});
try{if(localStorage.getItem('bb-cookie')==='1')$('#cookie').hidden=true}catch(e){}
$('#cookie-ok').addEventListener('click',function(){$('#cookie').hidden=true;try{localStorage.setItem('bb-cookie','1')}catch(e){}});
</script>
