<title>BB ช้อป</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,500;0,700;0,800;1,800&family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* Layout: sticky top bar, single-column mobile flow (hero > recent buys > stats > best sellers grid > steps > footer), slide-in menu drawer. Yellow/black taken from the BB HUB logo. */
:root{
  --bg:#0c0b06;
  --surface:#15130a;
  --surface-2:#1d1a0e;
  --line:#2c2812;
  --fg:#f7f3e2;
  --muted:#a9a38a;
  --accent:#ffd21f;
  --accent-ink:#1a1500;
  --accent-soft:rgba(255,210,31,.12);
  --ok:#43e08a;
  --art-a:#ffd21f;
  --art-b:#6b5500;
  --font-display:'Kanit','IBM Plex Sans Thai',system-ui,sans-serif;
  --font-body:'IBM Plex Sans Thai','Kanit',system-ui,sans-serif;
  color-scheme:dark;
}
@media (prefers-color-scheme: light){
  :root:not([data-theme="dark"]){
    --bg:#fffbe6;--surface:#ffffff;--surface-2:#fff4c2;--line:#eadf9f;--fg:#1a1500;--muted:#6f6742;
    --accent:#f5b800;--accent-ink:#1a1500;--accent-soft:rgba(245,184,0,.16);--ok:#12894a;--art-a:#ffd21f;--art-b:#3a2e00;color-scheme:light;
  }
}
:root[data-theme="light"]{
  --bg:#fffbe6;--surface:#ffffff;--surface-2:#fff4c2;--line:#eadf9f;--fg:#1a1500;--muted:#6f6742;
  --accent:#f5b800;--accent-ink:#1a1500;--accent-soft:rgba(245,184,0,.16);--ok:#12894a;--art-a:#ffd21f;--art-b:#3a2e00;color-scheme:light;
}
*{box-sizing:border-box}
body{overflow-x:clip;background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:15px;line-height:1.6;
  padding-block:0 96px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--bg)}
button{font:inherit;color:inherit;cursor:pointer}
a{color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.wrap{max-width:1080px;margin:0 auto}
h1,h2,h3{font-family:var(--font-display);margin:0;text-wrap:balance}

/* top bar */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);
  margin-inline:calc(-1*max(16px,env(safe-area-inset-left,0px))) calc(-1*max(16px,env(safe-area-inset-right,0px)));
  padding-inline:max(16px,env(safe-area-inset-left,0px)) max(16px,env(safe-area-inset-right,0px))}
.bar .wrap{display:flex;align-items:center;gap:12px;height:64px}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:800;font-size:22px;letter-spacing:.01em;text-decoration:none;margin-right:auto}
.brand img{width:38px;height:38px;border-radius:50%;border:2px solid var(--accent);object-fit:cover}
.brand b{color:var(--accent)}
.nav{display:none;gap:22px;margin-right:12px}
.nav a{text-decoration:none;color:var(--muted);font-weight:500}
.nav a:hover{color:var(--fg)}
.icon-btn{width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center}
.icon-btn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round}
.icon-btn:hover{border-color:var(--accent)}

/* hero */
.hero{padding-block:40px 28px;position:relative}
.hero::after{content:"";position:absolute;inset:-40px 0 auto auto;width:min(320px,80%);height:320px;background:radial-gradient(closest-side,var(--accent-soft),transparent);pointer-events:none;z-index:-1}
.status{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:8px 16px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.status i{width:9px;height:9px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 4px color-mix(in srgb,var(--ok) 22%,transparent)}
.status strong{color:var(--ok);font-weight:600}
.hero h1{font-size:clamp(44px,12vw,84px);line-height:1.12;font-weight:800;margin-top:22px;letter-spacing:-.01em}
.hero h1 em{font-style:normal;color:var(--accent);display:inline-block;position:relative}
.hero h1 em::after{content:"";position:absolute;left:0;right:0;bottom:2px;height:8px;background:var(--accent);opacity:.22;border-radius:4px}
.hero p{max-width:60ch;color:var(--muted);font-size:16px;margin:20px 0 0}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
.btn{border:1.5px solid var(--line);background:transparent;border-radius:999px;padding:14px 26px;font-family:var(--font-display);font-weight:700;font-size:16px;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);box-shadow:0 8px 28px -10px var(--accent)}
.btn.primary:hover{filter:brightness(1.06)}
.btn.ghost:hover{border-color:var(--accent)}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
.chip{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:8px 16px;font-size:14px}
.chip svg{width:18px;height:18px;stroke:var(--accent);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* recent buys + stats */
.two{display:grid;grid-template-columns:1fr;gap:16px;margin-top:28px}
.panel{border:1px solid var(--line);background:var(--surface);border-radius:22px;padding:20px 20px 8px;min-width:0}
.panel h3{font-size:18px;font-weight:700;display:flex;align-items:center;justify-content:space-between;gap:8px}
.tag{font-family:var(--font-body);font-size:11px;font-weight:500;color:var(--muted);border:1px dashed var(--line);border-radius:999px;padding:2px 10px}
.feed{list-style:none;margin:12px 0 0;padding:0}
.feed li{display:flex;gap:12px;align-items:flex-start;padding:12px 0;border-top:1px solid var(--line)}
.feed li:first-child{border-top:0}
.feed .dot{flex:none;width:34px;height:34px;border-radius:50%;background:var(--accent-soft);display:grid;place-items:center}
.feed .dot svg{width:17px;height:17px;stroke:var(--accent);fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.feed div{min-width:0}
.feed b{font-weight:600;overflow-wrap:anywhere}
.feed small{display:block;color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.stat{border:1px solid var(--line);background:var(--surface);border-radius:18px;padding:16px}
.stat strong{display:block;font-family:var(--font-display);font-size:clamp(20px,5.4vw,32px);font-weight:800;line-height:1.1;font-variant-numeric:tabular-nums;color:var(--accent)}
.stat span{font-size:13px;color:var(--muted)}

/* products */
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:44px}
.sec-head h2{font-size:clamp(28px,7vw,40px);font-weight:800}
.tabs{display:flex;gap:8px;overflow-x:auto;padding-block:4px;max-width:100%}
.tab{flex:none;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:8px 18px;font-weight:500;font-size:14px}
.tab[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);font-weight:600}
.empty{grid-column:1/-1;border:1px dashed var(--line);border-radius:22px;padding:48px 20px;text-align:center;display:grid;gap:4px;color:var(--muted)}
.empty b{font-family:var(--font-display);font-size:20px;color:var(--fg)}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}
.card{border:1px solid var(--line);background:var(--surface);border-radius:22px;overflow:hidden;display:flex;flex-direction:column;min-width:0}
.art{position:relative;aspect-ratio:4/3.1;max-width:100%;overflow:hidden;color:#fff;
  background:
   repeating-linear-gradient(115deg,transparent 0 22px,rgba(255,210,31,.07) 22px 24px),
   radial-gradient(120% 90% at 85% 0%,var(--art-b),transparent 60%),
   linear-gradient(160deg,#16130a,#050400)}
.art .q{position:absolute;width:34px;height:34px;border-radius:9px;background:var(--art-a);color:#1a1500;font-family:var(--font-display);font-weight:800;font-size:22px;display:grid;place-items:center;transform:rotate(-12deg);box-shadow:0 6px 18px -6px var(--art-a)}
.art .q1{left:10px;top:34px}.art .q2{right:12px;top:58px;transform:rotate(10deg)}
.art .name{position:absolute;left:12px;right:12px;bottom:46px;font-family:var(--font-display);font-weight:800;font-size:clamp(17px,4.8vw,26px);line-height:1.1;color:var(--art-a);text-shadow:0 2px 0 #000}
.art .price{position:absolute;left:12px;bottom:10px;background:var(--art-a);color:#1a1500;border-radius:999px;padding:1px 16px;font-family:var(--font-display);font-weight:800;font-size:clamp(15px,4.2vw,20px);font-variant-numeric:tabular-nums}
.ready{position:absolute;left:10px;top:10px;display:inline-flex;align-items:center;gap:6px;background:rgba(10,10,6,.78);border:1px solid rgba(255,255,255,.14);color:#e9ffe9;border-radius:999px;padding:3px 10px;font-size:12px}
.ready i{width:7px;height:7px;border-radius:50%;background:#43e08a}
.card .body{padding:14px 14px 16px;display:flex;flex-direction:column;gap:10px;flex:1}
.card small{color:var(--muted);font-size:12.5px}
.card h3{font-size:16px;font-weight:600;line-height:1.35;overflow-wrap:anywhere}
.buy-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding-top:12px;border-top:1px solid var(--line)}
.buy-row span{font-size:12px;color:var(--muted);display:block;line-height:1.2}
.buy-row b{font-family:var(--font-display);font-size:24px;font-weight:700;font-variant-numeric:tabular-nums}
.buy{border:1.5px solid var(--accent);color:var(--accent);background:transparent;border-radius:999px;padding:8px 18px;font-family:var(--font-display);font-weight:700}
.buy:hover,.buy.hot{background:var(--accent);color:var(--accent-ink)}

/* steps */
.steps{display:grid;grid-template-columns:1fr;gap:12px;margin-top:18px;counter-reset:s}
.step{border:1px solid var(--line);border-radius:20px;padding:18px 18px 18px 70px;position:relative;background:var(--surface)}
.step::before{counter-increment:s;content:counter(s);position:absolute;left:18px;top:16px;width:38px;height:38px;border-radius:12px;background:var(--accent);color:var(--accent-ink);font-family:var(--font-display);font-weight:800;font-size:20px;display:grid;place-items:center}
.step h3{font-size:17px;font-weight:700}
.step p{margin:2px 0 0;color:var(--muted);font-size:14px}

/* footer */
footer{margin-top:52px;border-top:1px solid var(--line);padding-block:28px 12px;display:grid;gap:18px}
footer .brand{margin:0}
.contacts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.contact{border:1px solid var(--line);background:var(--surface);border-radius:18px;padding:14px;text-align:left;display:flex;flex-direction:column;gap:2px;min-width:0}
.contact:hover{border-color:var(--accent)}
.contact b{font-family:var(--font-display);font-weight:600}
.contact span{color:var(--muted);font-size:13px;overflow-wrap:anywhere}
.fine{color:var(--muted);font-size:12.5px;margin:0}

/* drawer + modal */
.scrim{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:70;opacity:0;pointer-events:none;transition:opacity .2s}
.scrim.on{opacity:1;pointer-events:auto}
.drawer{position:fixed;z-index:80;top:0;right:0;bottom:0;width:min(420px,100%);background:var(--bg);border-left:1px solid var(--line);transform:translateX(100%);transition:transform .25s ease;overflow-y:auto;
  padding:calc(12px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) calc(24px + env(safe-area-inset-bottom,0px)) 16px}
.drawer.on{transform:none}
.drawer .top{display:flex;align-items:center;justify-content:space-between;height:52px}
.menu{display:grid;margin-top:8px}
.menu a{display:flex;align-items:center;gap:16px;padding:16px 8px;text-decoration:none;font-size:18px;border-radius:14px}
.menu a:hover{background:var(--surface)}
.menu svg{width:24px;height:24px;stroke:var(--muted);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.drawer h4{margin:22px 0 10px;font-family:var(--font-body);font-weight:500;color:var(--muted);font-size:14px;padding-top:18px;border-top:1px solid var(--line)}
.drawer .btn{width:100%;margin-top:10px}
.modal{position:fixed;z-index:90;left:50%;top:50%;transform:translate(-50%,-46%);width:min(440px,calc(100% - 32px));max-height:calc(100% - 48px);overflow-y:auto;background:var(--surface);border:1px solid var(--line);border-radius:24px;padding:22px;opacity:0;pointer-events:none;transition:.2s}
.modal.on{opacity:1;pointer-events:auto;transform:translate(-50%,-50%)}
.modal h3{font-size:22px;font-weight:800}
.modal p{color:var(--muted);margin:6px 0 0}
.modal .sum{display:flex;justify-content:space-between;align-items:baseline;gap:12px;border:1px solid var(--line);border-radius:16px;padding:14px 16px;margin-top:16px;background:var(--surface-2)}
.modal .sum b{font-family:var(--font-display);font-size:28px;color:var(--accent)}
.modal label{display:block;font-size:13px;color:var(--muted);margin-top:14px}
.modal input{width:100%;margin-top:6px;border:1px solid var(--line);background:var(--bg);color:var(--fg);border-radius:14px;padding:12px 14px;font:inherit}
.modal .row{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}
.modal .row .btn{flex:1}
.note{font-size:12.5px;color:var(--muted);margin-top:12px;border-left:3px solid var(--accent);padding-left:10px}
.result{margin-top:14px;font-size:14px;min-height:1.2em}

/* cookie + toast */
.cookie{position:fixed;z-index:40;left:0;right:0;bottom:0;padding:0 max(12px,env(safe-area-inset-right,0px)) calc(12px + env(safe-area-inset-bottom,0px)) max(12px,env(safe-area-inset-left,0px));pointer-events:none}
.cookie > div{max-width:760px;margin:0 auto;pointer-events:auto;display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:10px 10px 10px 16px;font-size:13.5px;box-shadow:0 12px 40px -12px #000}
.cookie p{margin:0;flex:1;min-width:0}
.cookie a{color:var(--accent)}
.cookie .btn{padding:10px 22px;min-height:44px}
.toast{position:fixed;z-index:100;left:50%;bottom:calc(88px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);background:var(--accent);color:var(--accent-ink);font-weight:600;border-radius:999px;padding:10px 20px;opacity:0;pointer-events:none;transition:.25s;max-width:calc(100% - 32px);text-align:center}
.toast.on{opacity:1;transform:translate(-50%,0)}

@media (min-width:720px){
  .nav{display:flex}
  .two{grid-template-columns:1.2fr 1fr;align-items:start}
  .grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .steps{grid-template-columns:repeat(3,1fr)}
  .contacts{grid-template-columns:repeat(4,minmax(0,1fr))}
  .hero{padding-block:72px 40px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>

<header class="bar">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="BB ช้อป หน้าแรก"><img alt="" src="data:image/webp;base64,"><span>BB <b>ช้อป</b></span></a>
    <nav class="nav" aria-label="เมนูหลัก">
      <a href="#shop">ร้านค้า</a><a href="#how">วิธีซื้อ</a><a href="#contact">ติดต่อเรา</a>
    </nav>
    <button class="icon-btn" id="theme" type="button" aria-label="สลับธีมสว่าง/มืด">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button class="icon-btn" id="open-menu" type="button" aria-label="เปิดเมนู" aria-controls="drawer">
      <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>

<main class="wrap" id="top">
  <section class="hero">
    <div class="status"><i></i><strong>ระบบส่งของทำงานอยู่</strong><span>· เปิดขายตลอด 24 ชม.</span></div>
    <h1>ไอดีเกมคัดแล้ว<br>จ่ายปุ๊บ <em>ได้ปั๊บ</em></h1>
